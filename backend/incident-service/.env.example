PORT=3001
NODE_ENV=development

# Database Configuration (TypeORM)
# Default DB_TYPE is 'sqlite' for zero-setup local execution without a PostgreSQL server.
# Change to DB_TYPE=postgres and provide valid credentials if using a local PostgreSQL server.
DB_TYPE=sqlite
DB_DATABASE=opstrack.sqlite

# PostgreSQL Configuration (used when DB_TYPE=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE_PG=opstrack_incidents
DB_SYNCHRONIZE=true

# Notification Service URL
NOTIFICATION_SERVICE_URL=http://localhost:3002/notifications
